<Window x:Class="WindowsTopBar.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Windows Top Bar"
        Left="0"
        Top="0"
        Width="640"
        Height="28"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        ShowActivated="False"
        Background="#F1EFEB"
        Foreground="#33353A">
    <Window.Resources>
        <Style x:Key="StatusTooltipTiming" TargetType="FrameworkElement">
            <Setter Property="ToolTipService.InitialShowDelay" Value="500" />
            <Setter Property="ToolTipService.BetweenShowDelay" Value="0" />
        </Style>
        <Style x:Key="StatusButton" TargetType="Button">
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Window}}" />
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="MinWidth" Value="33" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="Transparent" Margin="0,2">
                            <Border x:Name="Hover" Background="{TemplateBinding Foreground}" CornerRadius="4" Opacity="0" />
                            <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Hover" Property="Opacity" Value="0.12" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusGlyph" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
            <Setter Property="StrokeThickness" Value="1.45" />
            <Setter Property="StrokeStartLineCap" Value="Round" />
            <Setter Property="StrokeEndLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
        </Style>
    </Window.Resources>
    <Grid Background="Transparent">
        <Border Background="Transparent" MouseLeftButtonDown="BarBackground_MouseLeftButtonDown">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="主题">
                        <MenuItem x:Name="DarkThemeItem" Header="深色" IsCheckable="True" Click="Theme_Click" />
                        <MenuItem x:Name="LightThemeItem" Header="浅色" IsCheckable="True" Click="Theme_Click" />
                        <MenuItem x:Name="SystemThemeItem" Header="跟随主题" IsCheckable="True" Click="Theme_Click" />
                        <Separator />
                        <MenuItem x:Name="AcrylicItem" Header="亚克力效果" IsCheckable="True" Click="Acrylic_Click" />
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="打开配置文件目录" Click="OpenSettingsFolder_Click" />
                    <MenuItem Header="退出" Click="Exit_Click" />
                </ContextMenu>
            </Border.ContextMenu>
        </Border>
        <Button x:Name="ShortcutsButton" Style="{StaticResource StatusButton}" HorizontalAlignment="Left"
                Width="76" Margin="8,0,0,0" Click="Shortcuts_Click"
                PreviewMouseLeftButtonDown="Shortcuts_PreviewMouseLeftButtonDown"
                Content="快速启动 ▾" AutomationProperties.Name="快速启动">
            <Button.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开快速启动目录" Click="OpenShortcutsFolder_Click" />
                </ContextMenu>
            </Button.ContextMenu>
        </Button>
        <Border HorizontalAlignment="Right" Background="Transparent">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="QQButton" Width="36" Style="{StaticResource StatusButton}" Click="QQ_Click"
                        Visibility="Collapsed" AutomationProperties.Name="打开 QQ" ToolTip="QQ"
                        ToolTipService.InitialShowDelay="500" ToolTipService.BetweenShowDelay="0">
                    <Path x:Name="QQGlyph" Width="14.4" Height="16.2" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="M 8,0.7 C 4.8,0.7 3.3,3.2 3.1,6.6 L 2.9,8 C 1.4,9.9 0.6,12.7 1,14 C 1.4,14.7 2.3,13.6 3,12.9 C 3.3,14 3.7,14.7 4.2,15.1 C 2.2,15.5 1.8,17.1 3.9,17.4 C 5.6,17.7 6.9,17.1 8,16.7 C 9.1,17.1 10.4,17.7 12.1,17.4 C 14.2,17.1 13.8,15.5 11.8,15.1 C 12.3,14.7 12.7,14 13,12.9 C 13.7,13.6 14.6,14.7 15,14 C 15.4,12.7 14.6,9.9 13.1,8 L 12.9,6.6 C 12.7,3.2 11.2,0.7 8,0.7 Z" />
                </Button>
                <Button x:Name="WeChatButton" Width="36" Style="{StaticResource StatusButton}" Click="WeChat_Click"
                        Visibility="Collapsed" AutomationProperties.Name="打开微信" ToolTip="微信"
                        ToolTipService.InitialShowDelay="500" ToolTipService.BetweenShowDelay="0">
                    <Path x:Name="WeChatGlyph" Width="17.1" Height="15.3" Stretch="Uniform"
                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          Data="F0 M 7,1 C 3.2,1 0.5,3.5 0.5,6.5 C 0.5,8.2 1.4,9.5 2.6,10.5 L 2.1,12.6 4.7,11.4 C 5.4,11.6 6,11.8 6.7,11.8 C 6.6,11.4 6.5,11 6.5,10.6 C 6.5,7.3 9.4,4.8 13.1,4.8 C 12.3,2.5 9.9,1 7,1 Z M 4.1,4.5 A 0.75,0.75 0 1 0 5.6,4.5 A 0.75,0.75 0 1 0 4.1,4.5 Z M 8.4,4.5 A 0.75,0.75 0 1 0 9.9,4.5 A 0.75,0.75 0 1 0 8.4,4.5 Z M 13.1,5.8 C 10,5.8 7.5,7.9 7.5,10.6 C 7.5,13.3 10,15.4 13.1,15.4 C 13.9,15.4 14.6,15.3 15.2,15 L 17.3,16 16.8,14.1 C 18,13.2 18.7,12 18.7,10.6 C 18.7,7.9 16.2,5.8 13.1,5.8 Z M 10.4,9.3 A 0.65,0.65 0 1 0 11.7,9.3 A 0.65,0.65 0 1 0 10.4,9.3 Z M 14.5,9.3 A 0.65,0.65 0 1 0 15.8,9.3 A 0.65,0.65 0 1 0 14.5,9.3 Z" />
                </Button>
                <Button x:Name="ClashVergeButton" Style="{StaticResource StatusButton}" Visibility="Collapsed"
                        AutomationProperties.Name="Clash Verge" AutomationProperties.HelpText="单击切换 TUN，双击打开仪表板，右键打开菜单"
                        PreviewMouseLeftButtonDown="ClashVerge_PreviewMouseLeftButtonDown" Click="ClashVerge_Click"
                        ContextMenuOpening="ClashVerge_ContextMenuOpening"
                        ToolTipService.InitialShowDelay="500" ToolTipService.BetweenShowDelay="0">
                    <Button.ToolTip>
                        <ToolTip x:Name="ClashVergeToolTip" Opened="ClashVergeToolTip_Opened" Placement="Bottom">
                            <TextBlock x:Name="ClashVergeToolTipText" Text="Clash Verge" TextWrapping="Wrap" MaxWidth="320" />
                        </ToolTip>
                    </Button.ToolTip>
                    <Button.ContextMenu>
                        <ContextMenu Placement="MousePoint">
                            <MenuItem Header="仪表板" Tag="dashboard" Click="ClashVergeMenu_Click" />
                            <MenuItem Header="TUN" Tag="toggle_tun_mode" Click="ClashVergeMenu_Click" />
                            <MenuItem Header="退出" Tag="quit" Click="ClashVergeMenu_Click" />
                        </ContextMenu>
                    </Button.ContextMenu>
                    <TextBlock x:Name="ClashVergeLabel" Text="Clash Verge" />
                </Button>
                <TextBlock x:Name="AppSeparator" Text="|" Visibility="Collapsed"
                           Margin="4,0" VerticalAlignment="Center" Opacity="0.45" IsHitTestVisible="False" />
                <Grid x:Name="InputIndicator" MinWidth="33" Background="Transparent" Style="{StaticResource StatusTooltipTiming}"
                      ToolTip="输入法" AutomationProperties.Name="输入法">
                    <TextBlock x:Name="InputText" FontSize="12" FontWeight="SemiBold"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Grid>
                <Button x:Name="QuickSettingsButton" Style="{StaticResource StatusButton}" Click="QuickSettings_Click" AutomationProperties.Name="打开快速设置">
                    <StackPanel Orientation="Horizontal">
                        <Canvas x:Name="WifiIcon" Width="17" Height="16" Margin="0,0,14,0" Background="Transparent"
                                Style="{StaticResource StatusTooltipTiming}">
                            <Path Style="{StaticResource StatusGlyph}"
                                  Data="M 1.5,5.5 Q 8.5,-0.5 15.5,5.5 M 3.8,8 Q 8.5,4 13.2,8 M 6,10.4 Q 8.5,8.3 11,10.4" />
                            <Ellipse Width="2" Height="2" Canvas.Left="7.5" Canvas.Top="12.3"
                                     Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                            <Path x:Name="WifiDisconnected" Style="{StaticResource StatusGlyph}" Data="M 2,2 L 15,14" Visibility="Collapsed" />
                        </Canvas>
                        <Canvas x:Name="VolumeIcon" Width="17" Height="16" Background="Transparent"
                                Style="{StaticResource StatusTooltipTiming}">
                            <Path Style="{StaticResource StatusGlyph}" Data="M 1.5,6 L 4.4,6 8,3 8,13 4.4,10 1.5,10 Z" />
                            <Path x:Name="VolumeWaves" Style="{StaticResource StatusGlyph}" Data="M 11,5 Q 14,8 11,11 M 13.3,2.8 Q 18.3,8 13.3,13.2" />
                            <Path x:Name="VolumeMute" Style="{StaticResource StatusGlyph}" Data="M 11,6 L 15,10 M 15,6 L 11,10" Visibility="Collapsed" />
                        </Canvas>
                        <StackPanel x:Name="BatteryIndicator" Orientation="Horizontal" Margin="14,0,0,0" Background="Transparent"
                                    Style="{StaticResource StatusTooltipTiming}">
                            <TextBlock x:Name="BatteryText" Text="—" VerticalAlignment="Center" Margin="0,0,5,0" />
                            <Canvas Width="23" Height="15">
                                <Rectangle Width="19" Height="11" Canvas.Left="1" Canvas.Top="2" RadiusX="2.5" RadiusY="2.5"
                                           StrokeThickness="1.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Rectangle Width="1.7" Height="4.5" Canvas.Left="20.5" Canvas.Top="5.25" RadiusX="0.75" RadiusY="0.75"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Rectangle x:Name="BatteryFill" Width="0" Height="6.5" Canvas.Left="3.25" Canvas.Top="4.25" RadiusX="1" RadiusY="1"
                                           Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                <Path x:Name="BatteryCharging" Style="{StaticResource StatusGlyph}" Data="M 12,3.5 L 8.3,8 11.7,8 9.3,11.4" Visibility="Collapsed" />
                            </Canvas>
                        </StackPanel>
                    </StackPanel>
                </Button>
                <Border x:Name="ClockArea" Background="Transparent" Padding="10,0,14,0"
                        Style="{StaticResource StatusTooltipTiming}"
                        ToolTipService.Placement="Bottom" ToolTipService.HasDropShadow="False">
                    <TextBlock x:Name="ClockText" VerticalAlignment="Center" FontSize="13"
                               FontWeight="SemiBold" AutomationProperties.Name="当前时间" />
                </Border>
            </StackPanel>
        </Border>
    </Grid>
</Window>
